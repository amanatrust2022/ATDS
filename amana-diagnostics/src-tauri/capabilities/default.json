{
  "$schema": "../node_modules/@tauri-apps/cli/schema-capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for DiagnosticOS",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "updater:default",
    "fs:default",
    "process:default",
    "http:default",
    "dialog:default",
    "autostart:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
