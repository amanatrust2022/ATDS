{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiagnosticOS",
  "version": "1.2.1",
  "identifier": "com.amanatrust.diagnosticos",

  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src-tauri/webui"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiagnosticOS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["nextjs/**/*"],
    "publisher": "Amana Trust",
    "copyright": "© 2024 Amana Trust",
    "category": "Healthcare",
    "shortDescription": "Diagnostic Centre Management",
    "longDescription": "DiagnosticOS Local Hub — offline-first diagnostic centre management system for clinic LANs.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "shortcutsLocations": ["StartMenu", "Desktop"],
        "runAfterInstall": true,
        "startMenuFolder": "DiagnosticOS"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCODU0RDEyREY0RjY2RTgKUldUb1prL2ZFazJGcXprWWJxTTMzUUQ0NFBQYnpUTnh6bEtrM2Z6RzBCOENEUGFZNGx5Mnc3aVMK",
      "endpoints": [
        "https://github.com/amanatrust2022/amana-releases/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
