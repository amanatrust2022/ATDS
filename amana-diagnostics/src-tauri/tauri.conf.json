{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redian",
  "version": "1.2.20",
  "identifier": "com.voltex.redian",

  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src-tauri/webui"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Redian",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["node"],
    "resources": ["nextjs/**/*"],
    "publisher": "Voltex Technologies",
    "copyright": "© 2024 Voltex Technologies",
    "category": "Healthcare and Fitness",
    "shortDescription": "Diagnostic Centre Management",
    "longDescription": "Redian Local Hub — offline-first diagnostic centre management system for clinic LANs.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "startMenuFolder": "Redian"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MDM1RTM2MEE3MzY5MTkKUldRWmFYTUtObDREVmhvMVFnSkViUnpUUzl4Y0FTRk5EcUxSWWtQN3dFTkpWdERnYjFEMEc5YzAK",
      "endpoints": [
        "https://github.com/voltex-technologies/redian-releases/releases/latest/download/latest.json"
      ]
    },
    "shell": {}
  }
}
